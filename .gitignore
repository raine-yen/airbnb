# Dependencies and build output
node_modules/
.next/
dist/
website/.next/
website/dist/

# Source archives, private assets, render caches, and generated heavy media
incoming-assets/*
!incoming-assets/.gitkeep
properties/*/00-original-images/*
!properties/*/00-original-images/.gitkeep
properties/*/01-selected-images/*
!properties/*/01-selected-images/README.md
properties/*/03-generated-clips/*
!properties/*/03-generated-clips/README.md
properties/*/04-edit/*
!properties/*/04-edit/README.md
properties/*/05-review/*
!properties/*/05-review/README.md
properties/*/06-final/*
!properties/*/06-final/README.md
source-assets/model/*
!source-assets/model/.gitkeep
source-assets/textures/*
!source-assets/textures/.gitkeep
blender/working/*
!blender/working/.gitkeep
blender/backups/*
!blender/backups/.gitkeep
renders/
exports/vertical/*.mp4
exports/horizontal/*.mp4
exports/clean/*.mp4

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.token
credentials.json

# Local tooling
.DS_Store
Thumbs.db
*.log
